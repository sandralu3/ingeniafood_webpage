NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key
# Opcional: fuerza un modelo concreto si los defaults fallan en tu cuenta
# GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite
RECIPE_IMAGE_PROVIDER=bank
OPENAI_API_KEY=your_openai_api_key
# true = permite fotos OpenAI (sigue exigiendo tester + Premium/Paddle en código).
# false = apagado de emergencia (cero llamadas a OpenAI).
OPENAI_DISH_PHOTOS_ENABLED=true
# OPENAI_IMAGE_MODEL=gpt-image-1
APP_PRIVATE_ACCESS_KEY=1048271811
# Paddle Billing (sandbox primero)
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
PADDLE_API_KEY=pdl_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_PRICE_ID_MONTHLY=pri_...
PADDLE_PRICE_ID_YEARLY=pri_...
# Opcional: origen canónico para success/cancel del Checkout (producción)
# NEXT_PUBLIC_SITE_URL=https://ingeniafood.es

# Web Push (notificaciones del sistema en PWA)
# Genera claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:soporte@ingeniafood.es
